# ==============================
# GENERAL
# ==============================
*.log
*.tmp
*.swp
*.swo
.DS_Store
Thumbs.db

# ==============================
# BACKEND (Python / FastAPI)
# ==============================

# Byte-compiled / cache
backend/__pycache__/
backend/*.py[cod]
backend/*$py.class

# Virtual environments
backend/venv/
backend/.venv/
backend/env/
backend/.env

# Environment variables
# backend/.env.*
backend/*.local

# Distribution / packaging
backend/build/
backend/dist/
backend/*.egg-info/
backend/uploads/

# Testing
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/

# IDE
backend/.vscode/
backend/.idea/

# ==============================
# FRONTEND (React / Node)
# ==============================

# Node modules
frontend/node_modules/

# Build output
frontend/build/
frontend/dist/

# Logs
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# Environment files
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Editor
frontend/.vscode/
frontend/.idea/

